# 进化湾平台 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# 应用环境 (development / production)
ENVIRONMENT=production

# 数据库连接
DATABASE_URL=sqlite:///./data/app.db

# JWT密钥 - 生产环境必须设置强随机密钥
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# 默认管理员密码 - 首次初始化时生效，后续修改密码后不再使用
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-password

# 服务端口
PORT=8000

# CORS允许的域名（生产环境限制为实际域名）
CORS_ALLOW_ORIGINS=*
